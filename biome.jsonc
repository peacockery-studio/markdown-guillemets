{
  "$schema": "https://biomejs.dev/schemas/2.1.2/schema.json",
  "extends": ["ultracite"],
  "files": {
    "includes": ["**", "!bun.lock", "!out/**"]
  },
  "javascript": {
    "globals": ["suite", "test"]
  },
  "linter": {
    "rules": {
      "performance": {
        "noNamespaceImport": "off",
        "useTopLevelRegex": "off"
      },
      "style": {
        "useDefaultSwitchClause": "off",
        "useFilenamingConvention": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noEmptyBlockStatements": "off",
        "noConsole": "off"
      },
      "correctness": {
        "noUndeclaredVariables": "off"
      },
      "nursery": {
        "noAwaitInLoop": "off",
        "noShadow": "off"
      },
      "complexity": {
        "noForEach": "off"
      }
    }
  }
}
