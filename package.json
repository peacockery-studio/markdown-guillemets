{
  "name": "markdown-guillemets",
  "displayName": "Markdown French Guillemets",
  "description": "Syntax highlighting for guillemets «», brackets [], parentheses (), and braces {} in Markdown",
  "publisher": "PeacockeryStudio",
  "repository": {
    "type": "git",
    "url": "https://github.com/peacockery-studio/markdown-guillemets"
  },
  "version": "0.1.3",
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "markdown",
    "guillemets",
    "french",
    "brackets",
    "syntax",
    "highlighting"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#2E3440",
    "theme": "dark"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "commands": [
      {
        "command": "markdown-guillemets.customizeColors",
        "title": "Customize Colors",
        "category": "Markdown Guillemets"
      }
    ],
    "grammars": [
      {
        "scopeName": "markdown.guillemets",
        "path": "./syntaxes/markdown-guillemets.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.guillemets": "markdown"
        }
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "punctuation.definition.guillemets.markdown",
            "settings": {
              "foreground": "#4ecdc4"
            }
          },
          {
            "scope": "punctuation.definition.square.markdown",
            "settings": {
              "foreground": "#ff6b6b"
            }
          },
          {
            "scope": "punctuation.definition.round.markdown",
            "settings": {
              "foreground": "#feca57"
            }
          },
          {
            "scope": "punctuation.definition.curly.markdown",
            "settings": {
              "foreground": "#ff9ff3"
            }
          },
          {
            "scope": "punctuation.definition.angle.markdown",
            "settings": {
              "foreground": "#54a0ff"
            }
          },
          {
            "scope": "markup.bold.markdown",
            "settings": {
              "foreground": "#f59e0b",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "markup.italic.markdown",
            "settings": {
              "foreground": "#ff0000",
              "fontStyle": "italic"
            }
          },
          {
            "scope": "markup.inline.raw.string.markdown",
            "settings": {
              "foreground": "#10b981"
            }
          },
          {
            "scope": "markup.strikethrough.markdown",
            "settings": {
              "foreground": "#6b7280",
              "fontStyle": "strikethrough"
            }
          }
        ]
      }
    }
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/peacockery-studio/markdown-guillemets/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.9",
    "@types/vscode": "^1.102.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.7.1",
    "glob": "^13.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "mocha": "^11.7.5",
    "typescript": "^5.8.3",
    "ultracite": "^6.3.9"
  },
  "scripts": {
    "compile": "bunx tsc -p ./",
    "watch": "bunx tsc -watch -p ./",
    "lint": "bunx ultracite format",
    "package": "bunx vsce package",
    "test": "bunx tsc -p ./ && node ./out/test/runTests.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss}": [
      "npx ultracite format",
      "npx ultracite lint"
    ],
    "*.{md,mdx}": [
      "npx markdownlint-cli2"
    ]
  }
}
