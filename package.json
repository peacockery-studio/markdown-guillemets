{
  "name": "markdown-guillemets",
  "displayName": "Markdown French Guillemets",
  "version": "0.1.3",
  "description": "Syntax highlighting for guillemets «», brackets [], parentheses (), and braces {} in Markdown",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "markdown",
    "guillemets",
    "french",
    "brackets",
    "syntax",
    "highlighting"
  ],
  "bugs": {
    "url": "https://github.com/peacockery-studio/markdown-guillemets/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/peacockery-studio/markdown-guillemets"
  },
  "license": "MIT",
  "publisher": "PeacockeryStudio",
  "main": "./out/extension.js",
  "scripts": {
    "clean": "rm -rf out",
    "compile": "bun run clean && bunx tsc -p ./",
    "format": "bunx ultracite fix",
    "lint": "bunx ultracite check",
    "package": "bun run compile && bunx vsce package",
    "prepare": "husky",
    "test": "bunx tsc -p ./ && bunx mocha --ui tdd \"out/test/**/*.test.js\"",
    "watch": "bunx tsc -watch -p ./"
  },
  "contributes": {
    "commands": [
      {
        "command": "markdown-guillemets.customizeColors",
        "title": "Customize Colors",
        "category": "Markdown Guillemets"
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "punctuation.definition.guillemets.markdown",
            "settings": {
              "foreground": "#4ecdc4"
            }
          },
          {
            "scope": "punctuation.definition.square.markdown",
            "settings": {
              "foreground": "#ff6b6b"
            }
          },
          {
            "scope": "punctuation.definition.round.markdown",
            "settings": {
              "foreground": "#feca57"
            }
          },
          {
            "scope": "punctuation.definition.curly.markdown",
            "settings": {
              "foreground": "#ff9ff3"
            }
          },
          {
            "scope": "punctuation.definition.angle.markdown",
            "settings": {
              "foreground": "#54a0ff"
            }
          },
          {
            "scope": "markup.bold.markdown",
            "settings": {
              "foreground": "#f59e0b",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "markup.italic.markdown",
            "settings": {
              "foreground": "#ff0000",
              "fontStyle": "italic"
            }
          },
          {
            "scope": "markup.inline.raw.string.markdown",
            "settings": {
              "foreground": "#10b981"
            }
          },
          {
            "scope": "markup.strikethrough.markdown",
            "settings": {
              "foreground": "#6b7280",
              "fontStyle": "strikethrough"
            }
          }
        ]
      }
    },
    "grammars": [
      {
        "scopeName": "markdown.guillemets",
        "path": "./syntaxes/markdown-guillemets.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.guillemets": "markdown"
        }
      }
    ]
  },
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss}": [
      "bunx ultracite fix",
      "bunx ultracite check"
    ],
    "*.{md,mdx}": [
      "bunx markdownlint-cli2"
    ]
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/vscode": "1.102.0",
    "@vscode/vsce": "4.1.0",
    "husky": "^9.1.7",
    "lint-staged": "17.6.0",
    "mocha": "^12.0.3",
    "tm-grammars": "^1.32.22",
    "typescript": "7.0.2",
    "ultracite": "8.1.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "engines": {
    "vscode": "^1.102.0"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#2E3440",
    "theme": "dark"
  }
}
